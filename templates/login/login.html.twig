{% extends 'base.html.twig' %} {% block stylesheets %}
<!-- Add your custom stylesheets here -->
<link rel="stylesheet" href="{{ asset('styles/form.css') }}" />
{% endblock %} {% block title %}Login{% endblock %} {% block body %}
<div class="form-container">
    <form method="post">
        {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
        {% endif %} {% if app.user %}
        <div class="mb-3">
            Bonjour, {{ app.user.userIdentifier }},
            <a href="{{ path('app_logout') }}">ce déconnecté ?</a>
        </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Connecté vous</h1>

        <div class="form-group">
            <label for="username">Email</label>
            <input
                type="email"
                value="{{ last_username }}"
                name="_username"
                id="username"
                class="form-control"
                autocomplete="email"
                required
                autofocus
            />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input
                type="password"
                name="_password"
                id="password"
                class="form-control"
                autocomplete="current-password"
                required
            />
        </div>

        <input
            type="hidden"
            name="_csrf_token"
            value="{{ csrf_token('authenticate') }}"
        />

        {# Uncomment this section and add a remember_me option below your
        firewall to activate remember me functionality. See
        https://symfony.com/doc/current/security/remember_me.html

        <div class="checkbox mb-3">
            <input type="checkbox" name="_remember_me" id="_remember_me" />
            <label for="_remember_me">Remember me</label>
        </div>
        #}

        <button class="btn btn-lg btn-primary" type="submit">Sign in</button>
    </form>
</div>
{% endblock %}
